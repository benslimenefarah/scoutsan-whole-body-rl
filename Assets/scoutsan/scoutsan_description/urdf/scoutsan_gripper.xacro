<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scoutsan_gripper">

  <xacro:macro name="scoutsan_gripper">
    
    <link name="gripper_link">
      <inertial>
        <origin xyz="-3.9257E-06 -0.00027208 0.037806" rpy="0 0 0" />
        <mass value="0.34365" />
        <inertia
          ixx="0.00036805"
          ixy="-7.2868E-08"
          ixz="-5.0168E-08"
          iyy="0.0003341"
          iyz="-2.6462E-06"
          izz="0.00022294" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 ${pi} 0" />
        <geometry>
          <mesh filename="package://scoutsan_description/meshes/base_link.STL" />
        </geometry>
        <material name="gripper_black">
          <color rgba="0.2 0.2 0.2 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 ${pi} 0" />
        <geometry>
          <mesh filename="package://scoutsan_description/meshes/base_link.STL" />
        </geometry>
      </collision>
    </link>
    
    <link name="gripper_finger1_link">
      <inertial>
        <origin xyz="0.0030491 -0.0066024 0.0064209" rpy="0 0 0" />
        <mass value="0.014278" />
        <inertia
          ixx="1.7567E-06"
          ixy="-5.7832E-08"
          ixz="2.6803E-08"
          iyy="2.3034E-06"
          iyz="2.2145E-07"
          izz="1.3354E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://scoutsan_description/meshes/finger1_Link.STL" />
        </geometry>
        <material name="gripper_black">
          <color rgba="0.2 0.2 0.2 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://scoutsan_description/meshes/finger1_Link.STL" />
        </geometry>
      </collision>
    </link>
    
    <joint name="gripper_finger1_joint" type="fixed">
      <origin xyz="-0.0132 0.0265 -0.093" rpy="0 ${pi} ${-1.5708 - pi}" />
      <parent link="gripper_link" />
      <child link="gripper_finger1_link" />
    </joint>
    
    <link name="gripper_finger2_link">
      <inertial>
        <origin xyz="0.0030491 -0.0066024 0.0064209" rpy="0 0 0" />
        <mass value="0.014278" />
        <inertia
          ixx="1.7567E-06"
          ixy="-5.7832E-08"
          ixz="2.6803E-08"
          iyy="2.3034E-06"
          iyz="2.2145E-07"
          izz="1.3354E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://scoutsan_description/meshes/finger2_Link.STL" />
        </geometry>
        <material name="gripper_black">
          <color rgba="0.2 0.2 0.2 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://scoutsan_description/meshes/finger2_Link.STL" />
        </geometry>
      </collision>
    </link>
    
    <joint name="gripper_finger2_joint" type="fixed">
      <origin xyz="0.0132 -0.0265 -0.093" rpy="0 ${pi} ${1.5708 + pi}" />
      <parent link="gripper_link" />
      <child link="gripper_finger2_link" />
    </joint>
    
  </xacro:macro>

</robot>
