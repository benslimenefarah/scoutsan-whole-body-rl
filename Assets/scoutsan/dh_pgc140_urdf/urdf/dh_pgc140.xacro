<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:macro name="dh_pgc140_gripper" params="parent *origin">
    
    <joint name="gripper_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="gripper_link" />
    </joint>
    
    <link name="gripper_link">
      <inertial>
        <origin xyz="-3.9257E-06 -0.00027208 0.037806" rpy="0 0 0" />
        <mass value="0.34365" />
        <inertia
          ixx="0.00036805"
          ixy="-7.2868E-08"
          ixz="-5.0168E-08"
          iyy="0.0003341"
          iyz="-2.6462E-06"
          izz="0.00022294" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dh_pgc140_urdf/meshes/base_link.STL" />
        </geometry>
        <material name="">
          <color rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dh_pgc140_urdf/meshes/base_link.STL" />
        </geometry>
      </collision>
    </link>
    
    <link name="gripper_finger1_link">
      <inertial>
        <origin xyz="0.0030491 -0.0066024 0.0064209" rpy="0 0 0" />
        <mass value="0.014278" />
        <inertia
          ixx="1.7567E-06"
          ixy="-5.7832E-08"
          ixz="2.6803E-08"
          iyy="2.3034E-06"
          iyz="2.2145E-07"
          izz="1.3354E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dh_pgc140_urdf/meshes/finger1_Link.STL" />
        </geometry>
        <material name="">
          <color rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dh_pgc140_urdf/meshes/finger1_Link.STL" />
        </geometry>
      </collision>
    </link>
    
    <joint name="gripper_finger1_joint" type="prismatic">
      <origin xyz="0.0132 0.0265 0.093" rpy="0 0 -1.5708" />
      <parent link="gripper_link" />
      <child link="gripper_finger1_link" />
      <axis xyz="1 0 0" />
      <limit lower="0" upper="0.025" effort="140" velocity="1" />
    </joint>
    
    <link name="gripper_finger2_link">
      <inertial>
        <origin xyz="0.0030491 -0.0066024 0.0064209" rpy="0 0 0" />
        <mass value="0.014278" />
        <inertia
          ixx="1.7567E-06"
          ixy="-5.7832E-08"
          ixz="2.6803E-08"
          iyy="2.3034E-06"
          iyz="2.2145E-07"
          izz="1.3354E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dh_pgc140_urdf/meshes/finger2_Link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.79216 0.81961 0.93333 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dh_pgc140_urdf/meshes/finger2_Link.STL" />
        </geometry>
      </collision>
    </link>
    
    <joint name="gripper_finger2_joint" type="prismatic">
      <origin xyz="-0.0132 -0.0265 0.093" rpy="0 0 1.5708" />
      <parent link="gripper_link" />
      <child link="gripper_finger2_link" />
      <axis xyz="1 0 0" />
      <limit lower="0" upper="0.025" effort="140" velocity="1" />
      <mimic joint="gripper_finger1_joint" multiplier="1" offset="0" />
    </joint>
    
    <!-- Gazebo configurations to prevent fingers from falling due to gravity -->
    <gazebo reference="gripper_finger1_joint">
      <implicitSpringDamper>1</implicitSpringDamper>
      <springStiffness>1000</springStiffness>
      <springReference>0</springReference>
    </gazebo>
    
    <gazebo reference="gripper_finger2_joint">
      <implicitSpringDamper>1</implicitSpringDamper>
      <springStiffness>1000</springStiffness>
      <springReference>0</springReference>
    </gazebo>
    
    <!-- Transmissions for Gazebo hardware interface -->
    <transmission name="gripper_finger1_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="gripper_finger1_joint">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="gripper_finger1_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    
  </xacro:macro>
  
</robot>
