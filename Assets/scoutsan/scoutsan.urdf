<?xml version="1.0" ?>
<!-- ====================================================================== -->
<!-- v2: same structure as v1 (base+wheels+arm+gripper+camera+box),         -->
<!--     with added <collision> geometry for every link that was missing    -->
<!--     one. Changes from v1:                                              -->
<!--       * base_0    : added cylinder collision (arm mounting puck)       -->
<!--       * link3     : added cylinder collision                           -->
<!--       * link6     : added cylinder collision (wrist flange)            -->
<!--       * scoutsan_box : added box collision wrapping the visible STL    -->
<!--           bounding box (0.45 x 0.66 x 0.27 m, pivot at one corner so   -->
<!--           the collision is offset by half-size in each axis)           -->
<!--       * gripper_link, gripper_finger1/2_link : kept the original mesh  -->
<!--           collisions. NOTE: these are non-convex STLs. After import    -->
<!--           you MUST tick the "Convex" checkbox on each of their Mesh    -->
<!--           Colliders in Unity, or you will get the                      -->
<!--           "Non-convex MeshCollider with ArticulationBody" error.       -->
<!-- ====================================================================== -->
<robot name="scout_base">

  <!-- ============================ Materials ============================ -->
  <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
  <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>
  <material name="blue_custom"><color rgba="0.33 0.49 0.58 1.0"/></material>
  <material name="camera_material"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="gripper_black"><color rgba="0.2 0.2 0.2 1.0"/></material>

  <!-- ============================ Base ================================ -->
<link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scout_description/meshes/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scout_description/meshes/base_link.dae"/>
      </geometry>
    </collision>
  </link>


  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.23479"/>
    <parent link="base_link"/>
    <child link="base_footprint"/>
  </joint>

  <link name="inertial_link">
    <inertial>
      <mass value="40"/>
      <origin xyz="0.0 0.0 0.0"/>
      <inertia ixx="2.288641" ixy="0" ixz="0"
               iyy="5.103976" iyz="0"
               izz="3.431465"/>
    </inertial>
  </link>
  <joint name="inertial_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="inertial_link"/>
  </joint>

  <!-- ============================ Wheels ============================== -->
<link name="front_right_wheel_link">
    <inertial>
      <mass value="3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.1361" iyz="0" izz="0.7171"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scout_description/meshes/wheel_type1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.11653" radius="0.16459"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <origin rpy="3.14 0 0" xyz="0.249 -0.29153 -0.0702"/>
    <axis rpy="0 0 0" xyz="0 -1 0"/>
  </joint>

  <link name="front_left_wheel_link">
    <inertial>
      <mass value="3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.1361" iyz="0" izz="0.7171"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scout_description/meshes/wheel_type2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.11653" radius="0.16459"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin rpy="0 0 0" xyz="0.249 0.29153 -0.0702"/>
    <axis rpy="0 0 0" xyz="0 -1 0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <inertial>
      <mass value="3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.1361" iyz="0" izz="0.7171"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scout_description/meshes/wheel_type1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.11653" radius="0.16459"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin rpy="0 0 0" xyz="-0.249 0.29153 -0.0702"/>
    <axis rpy="0 0 0" xyz="0 -1 0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <inertial>
      <mass value="3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.1361" iyz="0" izz="0.7171"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scout_description/meshes/wheel_type2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.11653" radius="0.16459"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin rpy="3.14 0 0" xyz="-0.249 -0.29153 -0.0702"/>
    <axis rpy="0 0 0" xyz="0 -1 0"/>
  </joint>

  <!-- ====================== scoutsan box (on robot) ==================== -->
  <!-- Box mesh measured from scoutsan_box.stl after the visual's 0.001    -->
  <!-- scale: bounds 0.45 x 0.659 x 0.266 m. Pivot is at one corner        -->
  <!-- (visible mesh extends in +X +Y +Z from the link origin), so the     -->
  <!-- collision box is centered at half-size in each axis.                -->
  <link name="scoutsan_box">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutsan_description/meshes/scoutsan_box.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue_custom"/>
    </visual>

    <collision>
      <!-- Changed origin to 0 0 0 to match the visual mesh -->
      <origin rpy="0 0 0" xyz="0 0 0"/> 
      <geometry>
        <!-- Replaced the box with your STL mesh and matching scale -->
        <mesh filename="package://scoutsan_description/meshes/scoutsan_box.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="scoutsan_box_on_scout" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="-0.500 0.225 0.115"/>
    <parent link="base_link"/>
    <child link="scoutsan_box"/>
  </joint>
  <link name="scoutsan_box_top"/>
  <joint name="scoutsan_box_top_joint" type="fixed">
    <origin rpy="0 0 1.5707963267948966" xyz="0.25 0.300 0.25"/>
    <parent link="scoutsan_box"/>
    <child link="scoutsan_box_top"/>
  </joint>

  <!-- ====================== Cosmetic: camera =========================== -->
  <link name="camera_link">
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000020833" ixy="0" ixz="0"
               iyy="0.000020833" iyz="0"
               izz="0.000020833"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0.1 0"/>
      <geometry>
        <mesh filename="package://scoutsan_description/meshes/insta360.dae"/>
      </geometry>
      <material name="camera_material"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin rpy="4.721622653589793 -0.0735526 1.609582653589793"
            xyz="-0.194239 0.43609 0.764744"/>
  </joint>
  <link name="camera_equi_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_equi_optical_frame"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <!-- ========================= Doosan A0509 arm ======================== -->
  <joint name="doosan_on_scout" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="0.25 0 0.115"/>
    <parent link="base_link"/>
    <child link="base_0"/>
  </joint>

  <!-- base_0: arm mounting puck, ~155 mm tall (joint1 z-offset = 0.1555) -->
<link name="base_0">
    <inertial>
      <mass value="2.198"/>
      <origin xyz="-1e-06 -0.001096 0.058957"/>
      <inertia ixx="0.010511" ixy="4.9786e-06" ixz="7.1839e-06"
               iyy="0.012033" iyz="-2.3529e-05"
               izz="0.012481"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_0_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <!-- Changed from xyz="0 0 0.0775" to "0 0 0" to match visual -->
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <!-- Replaced the cylinder with the .dae mesh -->
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_0_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- joint1 -->
  <joint name="joint1" type="revolute">
    <parent link="base_0"/>
    <child link="link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.1555"/>
    <axis xyz="0 0 1"/>
    <limit effort="194" lower="-6.2832" upper="6.2832" velocity="3.1416"/>
    <dynamics friction="0"/>
  </joint>
<link name="link1">
    <inertial>
      <mass value="3.715"/>
      <origin xyz="-6.9e-05 0.024423 -0.007375"/>
      <inertia ixx="0.01899" ixy="7.8574e-07" ixz="1.865e-05"
               iyy="0.013731" iyz="-0.00072828"
               izz="0.01686"/>
    </inertial>
    
    <!-- Visuals -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_1_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_1_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_1_2.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <!-- Collisions -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_1_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_1_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_1_2.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- joint2 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin rpy="0 -1.571 -1.571" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="194" lower="-6.2832" upper="6.2832" velocity="3.1416"/>
    <dynamics friction="0"/>
  </joint>
<link name="link2">
    <inertial>
      <mass value="6.837"/>
      <origin xyz="0.20449 -1.2521e-17 0.13271"/>
      <inertia ixx="0.019399" ixy="0.00010317" ixz="4.2985e-06"
               iyy="0.25627" iyz="5.1674e-06"
               izz="0.25442"/>
    </inertial>
    
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_2_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_2_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_2_2.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_2_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_2_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_2_2.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>


  <!-- joint3 -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin rpy="0 0 1.571" xyz="0.409 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="163" lower="-2.7925" upper="2.7925" velocity="3.1416"/>
    <dynamics friction="0"/>
  </joint>
  <!-- link3: forearm housing. joint4 offsets -0.367 along Y, so this link  -->
  <!-- extends from the joint3 origin toward -Y. Cylinder is placed along  -->
  <!-- that direction.                                                     -->
<link name="link3">
    <inertial>
      <mass value="2.769"/>
      <origin xyz="7.1e-05 -0.005123 0.033009"/>
      <inertia ixx="0.012526" ixy="-7.1869e-06" ixz="1.3345e-05"
               iyy="0.013868" iyz="-0.00047287"
               izz="0.0088186"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_3_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_3_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_3_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_3_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- joint4 -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin rpy="1.571 0 0" xyz="0 -0.367 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-6.2832" upper="6.2832" velocity="6.2832"/>
    <dynamics friction="0"/>
  </joint>
<link name="link4">
    <inertial>
      <mass value="2.679"/>
      <origin xyz="-8.6e-05 0.086348 -0.086031"/>
      <inertia ixx="0.056068" ixy="2.2109e-05" ixz="1.4522e-05"
               iyy="0.047122" iyz="-0.014997"
               izz="0.013329"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_4_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_4_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_4_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_4_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- joint5 -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin rpy="-1.571 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-6.2832" upper="6.2832" velocity="6.2832"/>
    <dynamics friction="0"/>
  </joint>
<link name="link5">
    <inertial>
      <mass value="2.051"/>
      <origin xyz="9.1e-05 -0.006457 0.015434"/>
      <inertia ixx="0.0090788" ixy="-5.3997e-06" ixz="8.3955e-06"
               iyy="0.0084721" iyz="-0.0001816"
               izz="0.010453"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_5_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_5_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_5_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_5_1.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- joint6 -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin rpy="1.571 0 0" xyz="0 -0.124 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-6.2832" upper="6.2832" velocity="6.2832"/>
    <dynamics friction="0"/>
  </joint>
  <!-- link6: wrist flange where the gripper mounts. Short cylinder along  -->
  <!-- its own Z axis matches a typical wrist flange shape.                -->
<link name="link6">
    <inertial>
      <mass value="0.773"/>
      <origin xyz="-2.2e-05 -7e-06 -0.051746"/>
      <inertia ixx="0.0087483" ixy="7.9428e-06" ixz="1.7034e-06"
               iyy="0.0078566" iyz="9.6857e-06"
               izz="0.0044452"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_6_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dsr_description/meshes/a0509_blue/A0509_6_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================ Gripper ============================== -->
  <!-- IMPORTANT: gripper_link and the two finger links use MESH colliders.-->
  <!-- They are non-convex by default. After importing into Unity, find    -->
  <!-- each of their Mesh Colliders in the Hierarchy and tick the          -->
  <!-- "Convex" checkbox, otherwise you will get the                       -->
  <!-- "Non-convex MeshCollider with ArticulationBody is not supported"    -->
  <!-- error.                                                              -->
  <joint name="scoutsan_gripper_on_doosan" type="fixed">
    <origin rpy="3.141592653589793 0 3.141592653589793" xyz="0.0 0.0 0.0"/>
    <parent link="link6"/>
    <child link="gripper_link"/>
  </joint>
  <link name="gripper_link">
    <inertial>
